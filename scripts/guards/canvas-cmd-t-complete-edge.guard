# GUARD canvas-cmd-t-complete-edge
#
# The audit fixture sent only Cmd+T key-down, leaving the production shortcut
# latch held and treating every later synthetic press as the same edge. The
# break removes key-up and restores the two-tab stall instead of a full strip.
test: repeated canvas Cmd+T presses complete their key edges
red: 2026-08-18 at 972ab35
diff --git a/src/tests/chrome_register_tests.zig b/src/tests/chrome_register_tests.zig
index cc937c7..62d1656 100644
--- a/src/tests/chrome_register_tests.zig
+++ b/src/tests/chrome_register_tests.zig
@@ -320,7 +320,6 @@ test "repeated canvas Cmd+T presses complete their key edges" {
     try support.requireLiveShells(app.max_tabs);
     for (1..app.max_tabs) |_| {
         try support.pressCanvasKey(harness, iface, "t", .{ .primary = true });
-        try support.releaseCanvasKey(harness, iface, "t", .{ .primary = true });
     }
     try testing.expectEqual(app.max_tabs, state.model.ws().tab_count);
     try testing.expectEqual(@as(u64, 0), state.model.consumed_shortcut_keys_held);
