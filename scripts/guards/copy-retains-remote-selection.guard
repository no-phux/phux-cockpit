# GUARD copy-retains-remote-selection
#
# A successful copy used to mean two different things depending on which
# provider owned the pane: the local arm left the range highlighted, the remote
# arm told the coordinator to drop it and released both anchors. The highlight
# is the only confirmation that the copy took the range the user meant, and
# every Mac terminal this app's users arrive from keeps it.
#
# The break zeroes the anchors again, which is the remote arm's old behaviour.
# Selection MODE still ends either way -- that half is correct and is not what
# the test is pinning.
#
test: a successful copy ends selection mode on a remote pane and keeps its range
red: 2026-08-12 at 5bccbd2
diff --git a/src/cockpit/update.zig b/src/cockpit/update.zig
index b435be2..98de393 100644
--- a/src/cockpit/update.zig
+++ b/src/cockpit/update.zig
@@ -2040,6 +2040,8 @@ pub fn retainSelectionAfterCopy(state: *RemoteUiState) void {
     // not extend a range the user has finished with — while the anchors and
     // the coordinator's own range stay exactly where the copy found them.
     state.selecting = false;
+    state.start_anchor = 0;
+    state.end_anchor = 0;
 }
 
 fn clearRemoteSelection(model: *Model, state: *RemoteUiState) void {
