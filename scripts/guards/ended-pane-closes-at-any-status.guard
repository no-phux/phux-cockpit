# GUARD ended-pane-closes-at-any-status
#
# The worst thing this app ever did. `exit` in a shell inherits the last
# command's status, so an ordinary session ended after an ordinary failed
# command reported non-zero -- and a close gated on the exit code left a dead
# grid holding a full pane rect behind a permanent `EXIT 1` badge, with the
# sibling never reclaiming the space.
#
# The break puts the status gate back. A shell that ENDED is done at any
# status; only a pane that never got a process (`spawn_failed`, `rejected`)
# still earns a tombstone, because there is nothing to close to.
#
test: a non-zero exit closes its pane too, and the sibling reclaims the rect
red: 2026-08-12 at ff16fa2
diff --git a/src/cockpit/update.zig b/src/cockpit/update.zig
index b435be2..dcced5e 100644
--- a/src/cockpit/update.zig
+++ b/src/cockpit/update.zig
@@ -327,7 +327,7 @@ fn updateModel(model: *Model, msg: Msg, fx: *Fx) void {
                     moveResponsesToOutbound(pane, fx);
                 },
                 .exit => {
-                    pane.phase = if (event.reason == .rejected or event.reason == .spawn_failed) .failed else .ended;
+                    pane.phase = if (event.reason == .rejected or event.reason == .spawn_failed or event.code != 0) .failed else .ended;
                     pane.exit_code = event.code;
                     pane.exit_signal = event.signal;
                     pane.exit_reason = event.reason;
