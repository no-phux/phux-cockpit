# GUARD full-tab-strip-chrome-arrangements
#
# The chrome audit previously left chrome_top at its zero default, so it only
# exercised the fullscreen fallback and never the shipped titlebar strip. The
# break removes the measured 66pt titlebar state and restores that blind spot.
test: a full tab strip passes the layout audit in titlebar and fullscreen
red: 2026-08-18 at 272f44c
diff --git a/src/tests/chrome_register_tests.zig b/src/tests/chrome_register_tests.zig
index 2ad5f35..7abf489 100644
--- a/src/tests/chrome_register_tests.zig
+++ b/src/tests/chrome_register_tests.zig
@@ -337,7 +337,6 @@ test "a full tab strip passes the layout audit in titlebar and fullscreen" {
     for (1..app.max_tabs) |_| app.update(&state.model, .new_terminal, &state.effects);
     try testing.expectEqual(app.max_tabs, state.model.ws().tab_count);
 
-    state.model.ws().chrome_top = 66;
     try testing.expect(app.tabsRideTitlebarIn(&state.model, state.model.wsConst()));
     try sweep(state, "full tab strip in the titlebar");
 
