# GUARD one-frame-convergence
#
# THE case this whole mechanism was built for. `onFrame` returns at most one
# Msg and stopped at the first pane whose grid was wrong, so with N panes
# convergence took N frames -- and during a live window drag, where the size
# moves every frame, only one pane ever tracked the window while the other N-1
# rendered at a stale grid for the whole gesture.
#
# The first version of the test PASSED against that bug. It allowed "a few more
# frames" to settle, and four panes needed exactly four -- inside the
# allowance. Removing the fix below is what exposed it, and the test was then
# tightened to assert EXACTLY ONE viewport dispatch.
#
test: every pane converges on ONE frame, not one pane per frame
red: 2026-08-12 at 5bccbd2
diff --git a/src/cockpit/update.zig b/src/cockpit/update.zig
index b435be2..eb78315 100644
--- a/src/cockpit/update.zig
+++ b/src/cockpit/update.zig
@@ -476,12 +476,6 @@ fn updateModel(model: *Model, msg: Msg, fx: *Fx) void {
             // make its own cols/rows meaningless. The convergence below is
             // purely additive — it only touches panes the Msg did not name.
             commitPaneViewport(model, fx, size.terminal_ref, size.cols, size.rows);
-            const workspace = model.wsAt(size.window) orelse &model.primary;
-            const proposals = projection.proposedViewportsIn(model, workspace, size.size);
-            for (proposals.slice()) |proposal| {
-                if (proposal.terminal.eql(size.terminal_ref)) continue;
-                commitPaneViewport(model, fx, proposal.terminal, proposal.cols, proposal.rows);
-            }
             drainEveryPane(model, fx);
         },
         .surface_resized => |surface| {
