# GUARD osc8-pane-local-target-preview
#
# OSC 8 can put a trusted-looking URL on glass and a different href behind it.
# Removing the rendered cell+href receipt check lets a quick Cmd-click open the
# hidden destination before any authority preview was emitted. The guarded
# behavior falls back to visible text until that exact preview is rendered.
test: quick Cmd-click on an unpreviewed OSC 8 mismatch opens only visible text
red: 2026-08-18 at e6af8a1
diff --git a/src/terminal/session.zig b/src/terminal/session.zig
index b7ca207..a215af1 100644
--- a/src/terminal/session.zig
+++ b/src/terminal/session.zig
@@ -1809,9 +1809,6 @@ pub const Session = struct {
         const shown = session.textLinkAtCell(coordinate);
         if (session.hyperlinkUriAtCell(coordinate)) |href| explicit: {
             if (url_module.targetIdentity(href) == null) break :explicit;
-            if (shown) |text_link| {
-                if (!std.mem.eql(u8, text_link.url, href) and !session.previewWasRendered(coordinate, href)) break :explicit;
-            }
             return .{
                 .url = session.rememberLink(href) orelse return null,
                 .source = .osc8,
