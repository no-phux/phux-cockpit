# GUARD preserve-rejected-workspace-state
#
# A rejected state path used to remain writable because persistence checked only
# that a destination existed. The break restores that destructive answer, letting
# debounce and both shutdown routes replace future/corrupt source bytes.
test: a rejected existing state stays byte-exact through fresh interaction and shutdown
red: 2026-09-02 at 9c346ce
diff --git a/src/cockpit/model.zig b/src/cockpit/model.zig
index ff404d5..7f60062 100644
--- a/src/cockpit/model.zig
+++ b/src/cockpit/model.zig
@@ -115,5 +115,5 @@ pub const StatePersistence = struct {
     /// allowed to replace it. Every asynchronous and synchronous write path
     /// asks this before doing any work.
     pub fn enabled(state: *const StatePersistence) bool {
-        return state.path_len != 0 and !state.preserve_rejected_existing;
+        return state.path_len != 0;
     }
