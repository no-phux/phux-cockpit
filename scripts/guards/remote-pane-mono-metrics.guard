# GUARD remote-pane-mono-metrics
#
# Tokens built outside the painter carry no text-measure provider, and remote
# (phux) panes are sized from exactly that token set. Asking the SDK to measure
# then falls back to its estimator, which only knows `default_mono_font_id` is
# monospace -- cockpit's terminal face is registered at 64, so a remote pane got
# a PROPORTIONAL estimate: 26 * 0.877 em against the true 26 * 0.6 em, 46
# percent too wide.
#
# The break is the whole substitution removed, which is what the code did
# before. Measured, not guessed: the ratio is recorded in the test.
#
test: a pane sized without a text-measure provider uses the mono cell, not a sans estimate
red: 2026-08-12 at ff16fa2
diff --git a/src/cockpit/native/workspace_projection.zig b/src/cockpit/native/workspace_projection.zig
index 38ffa7e..0094d0c 100644
--- a/src/cockpit/native/workspace_projection.zig
+++ b/src/cockpit/native/workspace_projection.zig
@@ -292,10 +292,7 @@ pub fn legibilityOf(tokens: canvas.DesignTokens) Legibility {
 /// font swap to a different pitch fails there instead of quietly re-opening
 /// this bug.
 pub fn terminalCellMetricsFor(tokens: canvas.DesignTokens) canvas.TerminalCellMetrics {
-    if (tokens.text_measure != null) return canvas.terminalCellMetrics(tokens);
-    var estimating = tokens;
-    estimating.typography.mono_font_id = canvas.default_mono_font_id;
-    return canvas.terminalCellMetrics(estimating);
+    return canvas.terminalCellMetrics(tokens);
 }
 
 /// The band must be able to contain the tab triggers it hosts. The register
