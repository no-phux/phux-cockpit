# GUARD remote-tab-close-affordance
#
# A selected or hovered Phux tab displayed an enabled close button even though
# its lifetime belongs to the coordinator and the update path cannot close it.
# The break makes every provider identity look locally closeable again, which
# restores the enabled-looking no-op in both the button and context menu.
test: a coordinator-owned tab exposes no enabled close affordance
red: 2026-08-17 at b70223c
diff --git a/src/cockpit/native/workspace_projection.zig b/src/cockpit/native/workspace_projection.zig
index 3f8dba5..9392947 100644
--- a/src/cockpit/native/workspace_projection.zig
+++ b/src/cockpit/native/workspace_projection.zig
@@ -626,7 +626,8 @@ pub const max_terminal_title_bytes: usize = 96;
 /// terminal belongs to its coordinator, so presenting an enabled local close
 /// verb would be an action that can only silently do nothing.
 pub fn tabCanClose(id: TerminalRef) bool {
-    return provider_contract.isLocal(id);
+    _ = id;
+    return true;
 }
 
 /// Where a terminal LIVES, in the only coordinates anyone can act on: which
