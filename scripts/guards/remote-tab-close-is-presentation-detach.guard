# GUARD remote-tab-close-is-presentation-detach
#
# A remote tab used to be non-closeable because Phux owns its process. The
# break restores that conflation. Closing must detach only Cockpit presentation,
# retain the TerminalRef in provider inventory, and allow reopening it live.
test: a remote tab detaches presentation and reopens from retained inventory
red: 2026-09-02 at a12930e
diff --git a/src/cockpit/native/workspace_projection.zig b/src/cockpit/native/workspace_projection.zig
index d0e5ebe..b1c28f8 100644
--- a/src/cockpit/native/workspace_projection.zig
+++ b/src/cockpit/native/workspace_projection.zig
@@ -627,8 +627,8 @@ pub const max_terminal_title_bytes: usize = 96;
 /// Closing presentation topology never claims execution ownership. Local
 /// terminals additionally lose their owned process in update; remote terminals
 /// remain in provider inventory and can be admitted again.
-pub fn tabCanClose(_: TerminalRef) bool {
-    return true;
+pub fn tabCanClose(id: TerminalRef) bool {
+    return provider_contract.isLocal(id);
 }
 
 /// Where a terminal LIVES, in the only coordinates anyone can act on: which
