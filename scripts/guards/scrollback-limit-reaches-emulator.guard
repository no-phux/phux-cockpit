# GUARD scrollback-limit-reaches-emulator
#
# `scrollback_bytes` was parsed from the config, stored on the model, and then
# ignored: the session was built from a comptime `const` that merely HAPPENED
# to equal the config default. Anyone setting the knob got the default and no
# indication of it.
#
# The break restores the comptime const at the construction site. The
# `_ = max_scrollback_bytes;` is not part of the defect -- it is only there
# because Zig refuses an unused parameter, and without it the break would stop
# the tree compiling and prove nothing.
#
test: scrollback-limit reaches the emulator instead of being stored and ignored
red: 2026-08-12 at ff16fa2
diff --git a/src/terminal/session.zig b/src/terminal/session.zig
index bfb06b2..1a7187d 100644
--- a/src/terminal/session.zig
+++ b/src/terminal/session.zig
@@ -292,6 +292,7 @@ pub const Session = struct {
         initial_rows: u16,
         max_scrollback_bytes: usize,
     ) !*Session {
+        _ = max_scrollback_bytes;
         const session = try gpa.create(Session);
         errdefer gpa.destroy(session);
         session.* = .{
@@ -299,7 +300,7 @@ pub const Session = struct {
             .term = try vt.Terminal.init(io, gpa, .{
                 .cols = @intCast(@min(initial_cols, max_cols)),
                 .rows = @intCast(@min(initial_rows, max_rows)),
-                .max_scrollback = max_scrollback_bytes,
+                .max_scrollback = max_scrollback,
             }),
             .stream = undefined,
             .render = .empty,
