# GUARD sdk-pty-capacity
#
# Cockpit declared a 32-terminal registry while the pinned SDK backed only four
# live PTYs process-wide, making the fifth tab or split hit an invisible lower
# ceiling. The break used to restore the actual prior SDK pin; that pin no
# longer compiles this tree (build.zig passes AppOptions.native_extension,
# which it predates), so the break now sets the ceiling Cockpit derives from
# the SDK table to the 4 that pin backed, and the contract test fails at
# 4 < 32 exactly as it did against the real thing.
test: the SDK PTY table covers Cockpit's bounded terminal registry
red: 2026-09-02 at 7a00e4b
diff --git a/src/providers/local/provider.zig b/src/providers/local/provider.zig
index 13aa7ba..3503f16 100644
--- a/src/providers/local/provider.zig
+++ b/src/providers/local/provider.zig
@@ -45,7 +45,7 @@ pub const max_terminals: usize = 32;
 ///
 /// which drives the real app and reports what it reached, plus the rss,
 /// thread and descriptor cost of every shell it opened.
-pub const max_live_shells: usize = native_sdk.max_effect_ptys;
+pub const max_live_shells: usize = 4;
 
 pub const first_terminal_raw: u64 = @intFromEnum(LocalTerminalId.terminal_1);
 pub const clipboard_key: u64 = 100;
