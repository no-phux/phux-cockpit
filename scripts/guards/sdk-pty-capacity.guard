# GUARD sdk-pty-capacity
#
# Cockpit declared a 32-terminal registry while the pinned SDK backed only four
# live PTYs process-wide, making the fifth tab or split hit an invisible lower
# ceiling. The break restores the actual prior SDK pin, not a synthetic
# constant, and the contract test fails at 4 < 32.
test: the SDK PTY table covers Cockpit's bounded terminal registry
diff --git a/build.zig.zon b/build.zig.zon
index 47142e8..8efeeb3 100644
--- a/build.zig.zon
+++ b/build.zig.zon
@@ -152,8 +152,8 @@
         // - Comptime markup diagnostics name the markup again instead of
         //   failing on Zig 0.16's refusal to discard an error value.
         .native_sdk = .{
-            .url = "https://github.com/phall1/native/archive/7e783da8df366aa3a89de72287d2c6c81121355c.tar.gz",
-            .hash = "native_sdk-0.1.0-hzDzQvwwsgLU5tfq3ymTRoyx9vSyB6vHqHRqeihyppxJ",
+            .url = "https://github.com/phall1/native/archive/cff219789c456715266d64a9785b1588dd0cb77b.tar.gz",
+            .hash = "native_sdk-0.1.0-hzDzQpgrnQKU1_tCNpZFrA9mDL-lZhvgh0NVe-iqhJJ9",
         },
         // libghostty-vt: Ghostty's extracted terminal-state core, consumed
         // as the `ghostty-vt` Zig module. Pinned to the first upstream
