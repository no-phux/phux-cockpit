# GUARD settings-config-reveal
#
# Settings named the config path but offered no action, leaving users to
# reconstruct and navigate it by hand. The break keeps the visible button and
# all path/existence state but removes its effect, restoring the worse failure:
# an enabled-looking control that silently does nothing.
test: settings can reveal the exact active config file in Finder
red: 2026-08-17 at 0f1ae2e
diff --git a/src/cockpit/update.zig b/src/cockpit/update.zig
index a7cf1d7..c07fd0e 100644
--- a/src/cockpit/update.zig
+++ b/src/cockpit/update.zig
@@ -1039,12 +1039,7 @@ fn updateModel(model: *Model, msg: Msg, fx: *Fx) void {
             workspace.settings.reset();
             persistThemeChoice(model);
         },
-        .settings_reveal_config => {
-            const workspace = model.ws();
-            if (!workspace.settings.open or !workspace.settings.config_exists) return;
-            if (!model.config_file.enabled()) return;
-            fx.hostSend("native-sdk.os.revealPath", model.config_file.path());
-        },
+        .settings_reveal_config => {},
         .close_tab => |index| closeTab(model, fx, index),
         // "Close Others", from the tab's own menu. Walked from the END so a
         // tab dropping out from under the walk cannot skip its neighbour, and
