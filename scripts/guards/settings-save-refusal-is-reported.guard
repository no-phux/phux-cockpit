# GUARD settings-save-refusal-is-reported
#
# A read-only config used to accept a live theme preview, close Settings, write
# nothing, and provide no visible failure. The break restores that silence by
# removing both the preflight warning and the post-write refusal latch while
# leaving the surrounding model plumbing intact, so the named test reaches the
# actual behavioral assertion rather than failing to compile.
test: a config file that refuses the write is reported, not swallowed
red: 2026-08-17 at 4a15e98
diff --git a/src/cockpit/update.zig b/src/cockpit/update.zig
index a7cf1d7..7166315 100644
--- a/src/cockpit/update.zig
+++ b/src/cockpit/update.zig
@@ -246,11 +246,7 @@ fn writeTopologySnapshot(model: *Model, fx: *Fx) void {
 /// and `.no_destination` leaves it alone because that state is already said in
 /// full by the panel's own line.
 fn persistThemeChoice(model: *Model) void {
-    switch (model.writeConfigTheme(model.provider.io)) {
-        .written => model.config_write_refused = false,
-        .refused => model.config_write_refused = true,
-        .no_destination => {},
-    }
+    _ = model.writeConfigTheme(model.provider.io);
 }
 
 /// Re-arm the debounce. Starting a timer key that is already active REPLACES
@@ -993,7 +989,6 @@ fn updateModel(model: *Model, msg: Msg, fx: *Fx) void {
             // about to promise. Here rather than per frame because a `view` is
             // pure and must not touch a disk, and because the answer only has
             // to be true at the moment the user reads the line.
-            workspace.settings.config_writable = model.configFileWritable(model.provider.io);
             workspace.settings.config_exists = model.configFileExists(model.provider.io);
         },
         .settings_close => {
