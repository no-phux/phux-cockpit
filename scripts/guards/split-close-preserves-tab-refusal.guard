# GUARD split-close-preserves-tab-refusal
#
# Describe the defect this test exists to catch, and what removing the
# fix below puts back. Prose here is preserved across re-runs.
test: closing one pane of a full tab does not clear tab admission refusal
red: 2026-09-02 at 55f9110
diff --git a/src/cockpit/update.zig b/src/cockpit/update.zig
index 6919bd3..f7ef72b 100644
--- a/src/cockpit/update.zig
+++ b/src/cockpit/update.zig
@@ -1516,6 +1516,6 @@ fn closePaneForTerminal(model: *Model, fx: *Fx, terminal_ref: TerminalRef, kill_
     // Only a local close gives a process slot back. A TAB slot comes back when
     // the final topology leaf closes regardless of provider.
     if (providerKind(terminal_ref) == .local) model.terminal_limit_refused = false;
-    if (tab_removed) workspace.tab_limit_refused = false;
+    workspace.tab_limit_refused = false;
     if (workspace.tab_count == 0) retireEmptyWindow(model, fx, where.window);
 }
