# GUARD tab-admission-refusal-visible
#
# A full workspace now reaches admitTab, rolls its minted terminal back, and
# latches a visible refusal from that exact failure arm. The break removes the
# arm's latch while preserving rollback, restoring a silent failed admission.
test: a refused tab admission names the tab ceiling in chrome
red: 2026-08-18 at 1f42db4
diff --git a/src/cockpit/update.zig b/src/cockpit/update.zig
index 5022226..4187b90 100644
--- a/src/cockpit/update.zig
+++ b/src/cockpit/update.zig
@@ -783,7 +783,6 @@ fn updateModel(model: *Model, msg: Msg, fx: *Fx) void {
             adoptWorkingDirectory(model, origin, pane);
             if (!model.admitTab(pane.id)) {
                 _ = model.provider.destroyTerminal(pane.id);
-                model.ws().tab_limit_refused = true;
                 return;
             }
             _ = model.selectTerminal(pane.id);
