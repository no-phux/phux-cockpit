# GUARD tab-close-preserves-selection
#
# Closing a tab before the selected tab shifted the array but not the selected
# index, so focus jumped to the following terminal whenever the selected tab
# was not last. The break removes the one identity-preserving index adjustment
# and restores that jump.
test: closing an earlier tab preserves the selected terminal
red: 2026-08-17 at faff81d
diff --git a/src/cockpit/model.zig b/src/cockpit/model.zig
index 9253b0b..67dd79c 100644
--- a/src/cockpit/model.zig
+++ b/src/cockpit/model.zig
@@ -489,7 +489,6 @@ pub const Workspace = struct {
 
     pub fn dropTab(workspace: *Workspace, index: usize) void {
         if (index >= workspace.tab_count) return;
-        if (index < workspace.selected_tab) workspace.selected_tab -= 1;
         var cursor = index;
         while (cursor + 1 < workspace.tab_count) : (cursor += 1) workspace.tabs[cursor] = workspace.tabs[cursor + 1];
         workspace.tab_count -= 1;
