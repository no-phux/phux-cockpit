# GUARD tab-label-keeps-its-tail
#
# The strip stopped identifying anything. Once it windows, every visible tab
# is at (or near) `tab_min_extent`, which leaves 51.4pt of label -- six
# characters -- and the SDK's trailing ellipsis spends all six on the prefix
# every tab shares. Driven live at 16 tabs in an 1100pt window, the composited
# texture showed SEVEN tabs each reading "Termi..."; fullscreen at 1920pt
# showed fourteen.
#
# The break pins `tail_start` at the end of the title, so the loop can only
# grow the HEAD -- which is trailing elision, exactly the behaviour that
# shipped. It also drops `prevCodepointStart`, which nothing else calls; a
# break that leaves an unused function behind does not compile, and a break
# that does not compile proves nothing (this one was rejected twice by that
# check before it was right).
#
# Note WHY this test can go red at all where the rest of the suite could not:
# it reads the string handed to the renderer, not `semantics.label`. The
# accessibility label always carried the full "Terminal 10", which is why a
# strip painting one word seven times was invisible to every other test here.
#
# RE-DERIVED once already: the fix itself did not change shape, but the fit
# started targeting `labelFitBudget` instead of the raw box (a greedy fit lands
# on the boundary, where a sub-one-percent measurement disagreement decides the
# last character), so the recorded break stopped applying and guard-check said
# so. That is the staleness check working.
test: a shrunken tab keeps the END of its name, which is the half that identifies
red: 2026-08-15 at a09ccdb
diff --git a/src/cockpit/native/workspace_projection.zig b/src/cockpit/native/workspace_projection.zig
index 5785319..6bebc4b 100644
--- a/src/cockpit/native/workspace_projection.zig
+++ b/src/cockpit/native/workspace_projection.zig
@@ -618,18 +618,7 @@ pub fn elideTitleMiddleInto(
     var advanced = true;
     while (advanced) {
         advanced = false;
-        // TAIL FIRST: the tail is the half that identifies.
-        if (tail_start > head_end) {
-            const next_tail = prevCodepointStart(title, tail_start);
-            if (next_tail > head_end) {
-                if (composeElidedTitle(out, title, head_end, next_tail)) |candidate| {
-                    if (chromeTextWidth(tokens, candidate) <= budget) {
-                        tail_start = next_tail;
-                        advanced = true;
-                    }
-                }
-            }
-        }
+        tail_start = title.len;
         if (head_end < tail_start) {
             const next_head = nextCodepointEnd(title, head_end);
             if (next_head < tail_start) {
@@ -669,14 +658,6 @@ fn nextCodepointEnd(text: []const u8, index: usize) usize {
     return @min(text.len, index + len);
 }
 
-/// The start of the codepoint ending at `index`.
-fn prevCodepointStart(text: []const u8, index: usize) usize {
-    if (index == 0) return 0;
-    var start = index - 1;
-    while (start > 0 and text[start] & 0xc0 == 0x80) start -= 1;
-    return start;
-}
-
 /// WHETHER THE STRIP CAN STILL TELL ITS TABS APART.
 ///
 /// THE INSTRUMENT, in the shape `Legibility` already has, and for the same
