# GUARD tab-window-backward-scroll
#
# Removing the fix puts back a `visibleTabWindowIn` that recomputes the
# visible run from the selection ALONE, with no memory of where the strip was
# already scrolled to. Any selection past the right edge is forced into the
# last slot, so stepping BACKWARD scrolls the whole strip a full tab width for
# a tab that was already on screen, while forward cycling looks correct.
#
# Driven live on 2026-08-15 (9 tabs, 1100pt window, 7 drawn, cmd+shift+[):
#   Terminal 3@94 Terminal 4@221 ... Terminal 8@731  Terminal 9@859*
#   Terminal 2@94 Terminal 3@221 ... Terminal 7@731  Terminal 8@859*
# Terminal 8 needed no scroll and moved 127.43pt anyway, taking every other
# label with it — a tab under a resting pointer becomes a different tab on
# every keystroke.
#
# The break is compile-clean on purpose: the anchor field and its writer stay,
# only the rule that reads them goes. A break that stops the tree compiling
# would produce a non-zero exit that proves nothing about this test.
test: stepping backward to a tab already on screen does not scroll the strip
red: 2026-08-15 at 7da9ba9
diff --git a/src/cockpit/native/workspace_projection.zig b/src/cockpit/native/workspace_projection.zig
index a91c171..edd6294 100644
--- a/src/cockpit/native/workspace_projection.zig
+++ b/src/cockpit/native/workspace_projection.zig
@@ -179,38 +179,12 @@ pub fn visibleTabWindowIn(workspace: *const Workspace, band_width: f32) TabWindo
     const extent = @min(tab_extent, usable / @as(f32, @floatFromInt(shown)));
     if (shown == workspace.tab_count) return .{ .first = 0, .count = shown, .extent = extent };
     const selected = @min(workspace.selected_tab, workspace.tab_count - 1);
-    // SCROLL INTO VIEW, and only into view: the strip stays exactly where it
-    // is whenever the selection is already on screen, and otherwise moves the
-    // least it can — to the leading edge stepping backward, to the trailing
-    // edge stepping forward.
-    //
-    // The rule this replaced recomputed `first` from the selection alone,
-    // `if (selected < shown) 0 else selected - shown + 1`, which forces any
-    // selection past the right edge into the LAST slot. Forward that reads
-    // correctly, because the selection arrives at the edge it just walked off.
-    // Backward it scrolls a full tab width for a tab that needed no scroll at
-    // all: driven live on 2026-08-15 in a 1100pt window with 9 tabs and 7
-    // drawn, one cmd+shift+[ from Terminal 9 moved Terminal 8 — fully visible
-    // at x=731 — to x=859 and dragged the other six 127.43pt with it, twice in
-    // a row. The old rule was chosen to avoid recentring's jump under the
-    // pointer and then reproduced it on every backward step. Remembering where
-    // the strip already is avoids BOTH.
-    const max_first = workspace.tab_count - shown;
-    const anchor = @min(workspace.tab_window_first, max_first);
-    const first = if (selected < anchor)
-        selected
-    else if (selected >= anchor + shown)
-        selected - shown + 1
-    else
-        anchor;
-    const window = TabWindow{ .first = first, .count = shown, .extent = extent };
-    // The property every caller assumes and none of them re-checks: a strip
-    // that does not draw the selected tab has no visible selection at all.
-    // Absolute rather than differential — it holds for ANY anchor, including a
-    // stale one — so an anchor that stops being maintained fails here instead
-    // of quietly drawing the wrong seven tabs.
-    std.debug.assert(window.contains(selected));
-    return window;
+    // THE DEFECT, PUT BACK: `first` recomputed from the selection alone, with
+    // no memory of where the strip already was. It forces any selection past
+    // the right edge into the LAST slot, so every backward step scrolls the
+    // whole strip a full tab width even when the target tab was on screen.
+    const first = if (selected < shown) 0 else selected - shown + 1;
+    return .{ .first = first, .count = shown, .extent = extent };
 }
 
 /// Write back where the strip is scrolled to, so the next derivation can tell
