# GUARD ts-engine-intent
#
# An intent that moved the engine without an announcement left the core on a
# stale revision until the next unrelated event, and its next positional
# intent was then refused for a move it never heard about. The break applies
# the intent and never posts the invalidation.
test: an intent moves the engine and the core resyncs to the new revision
red: 2026-09-02 at dc536f8
build: test -Dtypescript-spike=true -Dplatform=null
diff --git a/typescript-spike/src/native_extension.zig b/typescript-spike/src/native_extension.zig
index e974fe2..b3757e8 100644
--- a/typescript-spike/src/native_extension.zig
+++ b/typescript-spike/src/native_extension.zig
@@ -120,7 +120,7 @@ const Bridge = struct {
         } else {
             _ = engine.applyIntent(payload, &cockpit.NoShells{});
         }
-        self.announce(engine);
+        if (false) self.announce(engine);
     }
 
     fn spawnShells(self: *Bridge, engine: *Engine, fx: EngineFx) void {
