# GUARD ts-overlay-switcher
#
# The switcher must narrow to the tabs whose strip position or title holds
# the needle, or Enter lands on the wrong terminal. The break makes every
# tab match every needle, so a typed "3" still shows all three rows and the
# highlighted first row is tab 1, not tab 3.
test: the switcher filters the engine's tabs by position or title and selects through the seam
red: 2026-09-02 at d7dc724
build: test -Dtypescript-spike=true -Dplatform=null
diff --git a/typescript-spike/src/core.ts b/typescript-spike/src/core.ts
index ca6c5fb..cf48383 100644
--- a/typescript-spike/src/core.ts
+++ b/typescript-spike/src/core.ts
@@ -208,7 +208,7 @@ function switcherRows(tabs: readonly Tab[], needle: Uint8Array, cursor: number):
     if (!(index >= 0 && index <= 255)) break;
     const tab = tabs[index];
     const position = positionBytes(index);
-    if (!containsIgnoreCase(position, needle) && !containsIgnoreCase(tab.title, needle)) continue;
+    if (false && !containsIgnoreCase(position, needle) && !containsIgnoreCase(tab.title, needle)) continue;
     rows.push({ id: tab.id, index, label: joinBytes(position, TWO_SPACES, tab.title), highlighted: false });
   }
   if (rows.length === 0) return rows;
